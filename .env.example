# Alert channels: set Telegram vars, Discord webhook, or both.
# At least one channel is required.

# Telegram: Bot API token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram: Chat ID to send alerts to (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=

# Discord: webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Optional: Override state file path from config.toml (default: last_signals.json)
# STATE_FILE=
